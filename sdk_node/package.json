{
  "name": "ziplogger",
  "version": "0.6.0",
  "description": "ZipLogger Node.js SDK \u2014 core client plus Pino and Winston transports, and the ziplogger CLI for releases, deploys and source maps from CI.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "ziplogger": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./winston": {
      "types": "./index.d.ts",
      "default": "./winston.js"
    },
    "./pino": {
      "types": "./index.d.ts",
      "default": "./pino.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/sessions.test.mjs test/cli.test.mjs"
  },
  "keywords": [
    "ziplogger",
    "logging",
    "pino",
    "winston",
    "observability",
    "releases",
    "sourcemaps",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziploggerhq/ZipLogger_Client.git",
    "directory": "sdk_node"
  },
  "peerDependencies": {
    "pino-abstract-transport": ">=1",
    "winston-transport": ">=4"
  },
  "peerDependenciesMeta": {
    "pino-abstract-transport": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    }
  },
  "homepage": "https://ziplogger.ai",
  "bugs": {
    "url": "https://github.com/ziploggerhq/ZipLogger_Client/issues"
  },
  "author": "Ahaliav Fox",
  "files": [
    "README.md",
    "index.d.ts",
    "index.js",
    "session.js",
    "pino.js",
    "winston.js",
    "cli.js",
    "cli-core.js"
  ]
}
