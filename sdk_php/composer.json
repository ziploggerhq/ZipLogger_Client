{
  "name": "ziplogger/ziplogger",
  "description": "ZipLogger PHP SDK: core client, Monolog handler and PSR-3 logger. Batching, retries, backpressure, automatic enrichment.",
  "type": "library",
  "license": "MIT",
  "keywords": ["ziplogger", "logging", "monolog", "psr-3", "observability", "logs"],
  "homepage": "https://ziplogger.ai",
  "authors": [
    { "name": "Ahaliav Fox" }
  ],
  "support": {
    "issues": "https://github.com/ziploggerhq/ZipLogger_Client/issues",
    "source": "https://github.com/ziploggerhq/ZipLogger_Client",
    "docs": "https://github.com/ziploggerhq/ZipLogger_Client/blob/main/docs/php.md"
  },
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "monolog/monolog": "^3.0"
  },
  "suggest": {
    "monolog/monolog": "To ship Monolog (Laravel, Symfony) records with ZipLogger\\Monolog\\ZipLoggerHandler (^2.0 || ^3.0)"
  },
  "autoload": {
    "psr-4": { "ZipLogger\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ZipLogger\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
